# Firebase project's Web API key (Firebase Console > Project settings > General).
# Must belong to the same project as the Firebase Admin credentials.
FIREBASE_WEB_API_KEY=AIzaSyCpEryLRbOcldrL2dn3k4tyzlaB6DQdLSc

# Set this to the app's /password-reset page. Also set Firebase Authentication >
# Templates > Password reset > Action URL to this same URL so the 10-minute check runs.
FIREBASE_PASSWORD_RESET_HANDLER_URL=http://localhost:5174/password-reset

# ImageKit stores profile photos and account documents. Only the backend uses
# the private key; never expose it through a VITE_ variable.
IMAGEKIT_PRIVATE_KEY=private_replace_me
IMAGEKIT_PUBLIC_KEY=public_replace_me
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Attendance mutations can additionally require Firebase App Check after the
# browser is configured to send X-Firebase-AppCheck. Keep false until then.
REQUIRE_FIREBASE_APP_CHECK=false
ATTENDANCE_MAX_SHIFT_HOURS=24
CRON_SECRET=replace-with-a-long-random-secret
