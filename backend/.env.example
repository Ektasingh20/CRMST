# Firebase project's Web API key (Firebase Console > Project settings > General).
# Must belong to the same project as the Firebase Admin credentials.
FIREBASE_WEB_API_KEY=

# Set this to the app's /password-reset page. Also set Firebase Authentication >
# Templates > Password reset > Action URL to this same URL so the 10-minute check runs.
FIREBASE_PASSWORD_RESET_HANDLER_URL=http://localhost:5174/password-reset
