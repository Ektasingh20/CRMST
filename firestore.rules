rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdminUser() {
      return signedIn() && request.auth.token.role in ['admin', 'Admin', 'Administrator', 'Super Admin'];
    }

    function isStudentUser() {
      return signedIn() && request.auth.token.role == 'student';
    }

    function userOwnsStudentDoc(studentId) {
      return signedIn() && request.auth.uid == studentId;
    }

    match /students/{studentId} {
      allow read: if signedIn() && (
        isAdminUser() || userOwnsStudentDoc(studentId)
      );
      allow create, update, delete: if isAdminUser() || userOwnsStudentDoc(studentId);

      match /enrolledCourses/{courseId} {
        allow read: if signedIn() && (
          isAdminUser() || userOwnsStudentDoc(studentId)
        );
        allow create, update, delete: if isAdminUser() || userOwnsStudentDoc(studentId);
      }

      match /enrollmentRequests/{requestId} {
        allow read: if signedIn() && (
          isAdminUser() || userOwnsStudentDoc(studentId)
        );

        allow create: if signedIn() && (
          isAdminUser() || userOwnsStudentDoc(studentId)
        ) && request.resource.data.studentId == studentId
          && request.resource.data.courseId is string
          && request.resource.data.courseName is string
          && request.resource.data.status == 'pending'
          && request.resource.data.requestedAt is string;

        allow update: if signedIn() && (
          isAdminUser() || userOwnsStudentDoc(studentId)
        ) && resource.data.studentId == studentId
          && request.resource.data.status in ['pending', 'contacted', 'done'];

        allow delete: if isAdminUser();
      }

      match /notifications/{notificationId} {
        allow read: if signedIn() && (
          isAdminUser() || userOwnsStudentDoc(studentId)
        );
        allow create, update, delete: if false;
      }
    }

    match /{path=**}/enrollmentRequests/{requestId} {
      allow read: if signedIn() && (
        isAdminUser() || resource.data.studentId == request.auth.uid
      );
      allow list: if signedIn() && isAdminUser();
      allow create: if false;
      allow update, delete: if signedIn() && isAdminUser();
    }

    match /courses/{courseId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdminUser();
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdminUser();

      match /members/{memberId} {
        allow read: if signedIn();
        allow create, update, delete: if isAdminUser();

        match /notifications/{notificationId} {
          allow read: if signedIn() && (
            isAdminUser() || request.auth.uid == memberId
              || resource.data.recipientId == request.auth.uid
          );
          allow create, update, delete: if false;
        }

        match /profileDocuments/{documentKey} {
          allow read: if signedIn() && (
            isAdminUser() || request.auth.uid == memberId
          );
          allow create, update, delete: if false;
        }
      }
    }

    // Temporary read compatibility for notifications created before the
    // per-recipient hierarchy migration. New backend writes never use it.
    match /notifications/{notificationId} {
      allow read: if signedIn() && (isAdminUser() || resource.data.recipientId == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /whatsappMessages/{templateId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdminUser();
    }

    // Attendance mutations are performed only by the authenticated backend.
    // Firebase Admin bypasses these rules, so API handlers enforce employee
    // ownership and role checks before every operation.
    match /attendance/{employeeId} {
      allow read: if signedIn() && (
        isAdminUser() || resource.data.employeeUid == request.auth.uid
      );
      allow create, update, delete: if false;

      match /months/{month}/attendanceDays/{workDate} {
        allow read: if signedIn() && (
          isAdminUser() || resource.data.employeeUid == request.auth.uid
        );
        allow create, update, delete: if false;
      }
    }

    // Call lists are served by the authenticated API, which validates ownership.
    match /listData/{document=**} {
      allow read, write: if false;
    }
  }
}
