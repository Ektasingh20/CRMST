{
  "name": "system-tech-crm",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "cd frontend && vite --host localhost --port 5174",
    "dev:api": "nodemon --config nodemon.json backend/index.js",
    "start:api": "node backend/index.js",
    "migrate:call-lists": "node backend/scripts/migrateCallListHierarchy.js",
    "migrate:call-list-dates": "node backend/scripts/migrateCallListDates.js",
    "plan:call-list-metadata": "node backend/scripts/prepareCallListMetadata.js",
    "migrate:leaves": "node backend/scripts/migrateLeavesHierarchy.js",
    "migrate:tasks": "node backend/scripts/migrateTasksByAssignee.js",
    "plan:notifications": "node backend/scripts/migrateNotificationsHierarchy.js",
    "migrate:notifications": "node backend/scripts/migrateNotificationsHierarchy.js --apply",
    "plan:attendance-migration": "node backend/scripts/migrateAttendanceHierarchy.js",
    "plan:future-attendance": "node backend/scripts/auditFutureAttendance.js",
    "migrate:attendance": "node backend/scripts/migrateAttendanceHierarchy.js --apply --confirm=KEEP_LEGACY_AND_COPY",
    "backfill:attendance": "node backend/scripts/backfillAttendance.js",
    "seed:ram-attendance-test": "node backend/scripts/seedRamAttendanceTest.js",
    "restore:ram-attendance-test": "node backend/scripts/restoreRamAttendanceTest.js",
    "cleanup:ram-attendance-test": "node backend/scripts/restoreRamAttendanceTest.js",
    "seed:message-templates": "node backend/scripts/seedMessageTemplates.js",
    "migrate:whatsapp": "node backend/scripts/migrateWhatsAppCollections.js",
    "seed:whatsapp-config": "node backend/scripts/seedWhatsAppConfig.js",
    "normalize:call-lists": "node backend/scripts/normalizeCallListDocuments.js",
    "normalize:leads": "node backend/scripts/normalizeLeadDocuments.js",
    "cleanup:duplicate-leads": "node backend/scripts/cleanupDuplicateLeads.js",
    "cleanup:duplicate-call-list": "node backend/scripts/cleanupDuplicateCallRecords.js",
    "build": "cd frontend && vite build",
    "preview": "cd frontend && vite preview",
    "test": "node --experimental-test-module-mocks --test backend/tests/*.test.js frontend/tests/*.test.js",
    "test:attendance": "node --test backend/tests/attendanceStore.test.js backend/tests/attendanceAutomation.test.js backend/tests/attendanceSecurityConfig.test.js backend/tests/attendanceTestSeed.test.js backend/tests/leaveModel.test.js frontend/tests/attendanceReport.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "firebase-admin": "^14.3.0",
    "html2canvas": "^1.4.1",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.542.0",
    "multer": "^2.5.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "serverless-http": "^3.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "nodemon": "^3.0.3",
    "vite": "^7.1.3"
  }
}
